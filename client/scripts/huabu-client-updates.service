[Unit]
Description=Mirror verified Huabu client releases
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=huabu-updates
Group=huabu-updates
StateDirectory=huabu-client-updates
StateDirectoryMode=0755
UMask=0022
ExecStart=/opt/huabu-client-updates/venv/bin/python /opt/huabu-client-updates/mirror-release.py --repository heiyuan0801/huabu-releases --destination /var/lib/huabu-client-updates/public --public-base-url https://image.iyuns.com/client-updates --macos-public-key /opt/huabu-client-updates/macos-update.pub --windows-public-key /opt/huabu-client-updates/windows-update.pem
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
